# Load packages ###############################################################
library(psych)
library(tidyverse)
library(readxl)
library(tidyr)
library(officer)
library(flextable)
library(effsize)
library(stringr)

# Read in data file ###############################################################
data <- read_excel("tbi.xlsx")

# Describe data
describe(data)

table(data$TBI1)
str(data$Accuracy)

# Test TBI vs No TBI ############################################################
t.test(Accuracy ~ TBI1, data = data)
t.test(PP ~ TBI1, data = data)
t.test(N300 ~ TBI1, data = data)
# Effect sizes - Cohen's d
cohen.d(Accuracy ~ TBI1, data = data)
cohen.d(PP ~ TBI1, data = data)
cohen.d(N300 ~ TBI1, data = data)

# Test symptom severity #########################################################
# Filter so it's only the TBI yes participants
tbi_yes_data <- data %>%
  filter(TBI1 == "Yes")

# Count up the number of symptoms to get symptom severity 
tbi_yes_data <- tbi_yes_data %>%
  mutate(
    SymptomCount = case_when(
      TBI2 == "None" ~ 0,
      TRUE ~ str_count(TBI2, ",") + 1
    )
  )

# Test is symptom severity predicts outcomes
model1 <- lm(scale(Accuracy) ~ scale(SymptomCount), data = tbi_yes_data)
summary(model1)
summary(model1)$r.squared

model2 <- lm(scale(PP) ~ scale(SymptomCount), data = tbi_yes_data)
summary(model2)
summary(model2)$r.squared

model3 <- lm(scale(N300) ~ scale(SymptomCount), data = tbi_yes_data)
summary(model3)
summary(model3)$r.squared

