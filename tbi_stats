### Demogrpahics #################################################
data <- data %>%
  mutate(GenderSimplified = case_when(
    str_detect(tolower(Gender), "female|woman") ~ "Woman",
    str_detect(tolower(Gender), "male|man") ~ "Man",
    str_detect(tolower(Gender), "Gender Queer|Gender fluid|Gender queer|GenderQueer|Genderfluid|
               Transgender Female|Transgender Male|TransgenderFemale/TransWoman/MTF|
               TransgenderMale/TransMan/FTM|TransgenderNonbinary") ~ "Nonbinary/Transgender",
    TRUE ~ "Other/Unspecified"
  ))

# Collapse less common Race categories
top_races <- data %>%
  count(Race) %>%
  arrange(desc(n)) %>%
  filter(n / sum(n) > 0.05) %>%
  pull(Race)

data <- data %>%
  mutate(RaceSimplified = if_else(Race %in% top_races, Race, "Other"))

# Gender summary
gender_table <- data %>%
  count(GenderSimplified) %>%
  mutate(Percent = round(n / sum(n) * 100, 1))

# Race summary
race_table <- data %>%
  count(RaceSimplified) %>%
  mutate(Percent = round(n / sum(n) * 100, 1))

ethnicity_table <- data %>%
  count(Ethnicity) %>%
  mutate(Percent = round(n / sum(n) * 100, 1)) %>%
  rename(n = n)

age_stats <- data %>%
  summarise(Mean_Age = round(mean(Age, na.rm = TRUE), 1),
            SD_Age = round(sd(Age, na.rm = TRUE), 1))

#Create Flextables 
gender_ft <- flextable(gender_table)
race_ft <- flextable(race_table)
ethnicity_ft <- flextable(ethnicity_table)
age_ft <- flextable(age_stats)

# Export to Word 
doc <- read_docx()

doc <- doc %>%
  body_add_par("Participant Demographics", style = "heading 1") %>%
  body_add_par("Gender", style = "heading 2") %>%
  body_add_flextable(gender_ft) %>%
  body_add_par("Race", style = "heading 2") %>%
  body_add_flextable(race_ft) %>%
  body_add_par("Ethnicity", style = "heading 2") %>%
  body_add_flextable(ethnicity_ft) %>%
  body_add_par("Age (M, SD)", style = "heading 2") %>%
  body_add_flextable(age_ft)

print(doc, target = "Demographics_Table.docx")

