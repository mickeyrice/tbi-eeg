# Make tables!! ###############################################################

# Count TBI symptoms
## Split the TBI2 column into a list of individual symptoms
data_long <- data %>%
  mutate(TBI2 = strsplit(as.character(TBI2), ",")) %>%
  unnest(TBI2)

data_long <- data_long %>%
  mutate(TBI2 = trimws(TBI2))

symptom_count <- data_long %>%
  group_by(TBI2) %>%
  summarise(Count = n(), .groups = 'drop') %>%
  arrange(desc(Count))

print(symptom_count)

kable(symptom_count, caption = "Symptom Frequency Count")

## Create a new Word document
doc <- read_docx()

## Add a title 
doc <- doc %>%
  body_add_par("Symptom Frequency Report", style = "heading 1")

## Add the symptom count table
doc <- doc %>%
  body_add_flextable(flextable(symptom_count))

## Save the Word document
print(doc, target = "Symptom_Frequency_Report.docx")

# TBI info tables
tbi_status_table <- data %>%
  group_by(TBI1) %>%
  summarise(Count = n(),
            Percent = n() / nrow(data) * 100, .groups = 'drop')

tbi_info_table <- tbi_yes_data %>%
  group_by(TBI1) %>%
  summarise(Count = n(),
            MeanSymptoms = mean(SymptomCount, na.rm = TRUE),
            SDSymptoms = sd(SymptomCount, na.rm = TRUE), .groups = 'drop')

## Create a new Word document
doc <- read_docx()

## Add a title 
doc <- doc %>%
  body_add_par("TBI Status and Symptom Information", style = "heading 1")

## Add the first table (TBI Status Table)
doc <- doc %>%
  body_add_par("TBI Status Table (Count and Percent)", style = "heading 2") %>%
  body_add_flextable(flextable(tbi_status_table))

## Add the second table (TBI Info Table)
doc <- doc %>%
  body_add_par("TBI Symptom Information (Mean and SD of Symptoms)", style = "heading 2") %>%
  body_add_flextable(flextable(tbi_info_table))

## Save the Word document
print(doc, target = "tbi_info_tables.docx")
